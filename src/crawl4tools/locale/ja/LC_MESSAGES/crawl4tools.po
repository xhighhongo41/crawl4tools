msgid ""
"--output can only be used with a single URL; use --output-dir for several"
" URLs"
msgstr "--output は URL が 1 つのときだけ使えます。複数の URL には --output-dir を使ってください"

#, python-brace-format
msgid "duplicate URL ignored: {url}"
msgstr "重複した URL を無視しました: {url}"

#, python-brace-format
msgid "could not write {path}: {reason}"
msgstr "{path} に書き込めません: {reason}"

msgid "Download web pages as Markdown and other formats."
msgstr "Web ページを Markdown などの形式でダウンロードします。"

msgid "Output format."
msgstr "出力形式を指定します。"

msgid "Write the (single) fetched URL to this file instead of stdout."
msgstr "取得した(1 つの)URL を標準出力ではなくこのファイルに書き込みます。"

msgid "Directory to save fetched URLs into."
msgstr "取得した URL を保存するディレクトリです。"

msgid "Proxy URL (http, https, or socks5); e.g. socks5://host:1080."
msgstr "プロキシ URL(http、https、socks5 のいずれか)です。例: socks5://host:1080。"

msgid "Retry without the proxy when the proxy itself appears to be at fault."
msgstr "プロキシ自体に問題があると見られる場合は、プロキシなしで再試行します。"

msgid "Maximum number of URLs fetched at once."
msgstr "同時に取得する URL の最大数です。"

msgid "Per-URL timeout in seconds."
msgstr "URL ごとのタイムアウト(秒)です。"

msgid "Add Markdown citations."
msgstr "Markdown に引用を付けます。"

msgid ""
"Keep only the main content (drop menus, footers, and the like) in the "
"Markdown."
msgstr "Markdown に本文だけを残します(メニューやフッターなどを除きます)。"

msgid "Strip links from the Markdown."
msgstr "Markdown からリンクを除きます。"

msgid "Strip images from the Markdown."
msgstr "Markdown から画像を除きます。"

msgid "Suppress progress and note lines."
msgstr "進捗と note 行を表示しません。"

msgid "Enable verbose engine logging."
msgstr "エンジンの詳細なログを出力します。"

msgid ""
"Language of messages: en or ja. Defaults to the locale (LANGUAGE, LC_ALL,"
" LC_MESSAGES, LANG), else en."
msgstr ""
"メッセージの言語(en または ja)です。省略時はロケール(LANGUAGE, LC_ALL, LC_MESSAGES, "
"LANG)に従い、決まらなければ en です。"

msgid "Show the version and exit."
msgstr "バージョンを表示して終了します。"

#, python-brace-format
msgid "fetch failed: {url}"
msgstr "取得に失敗しました: {url}"

#, python-brace-format
msgid "{succeeded} succeeded, {failed} failed"
msgstr "成功 {succeeded} 件、失敗 {failed} 件"

#, python-brace-format
msgid "fetch failed: {summary}: {url}"
msgstr "取得に失敗しました: {summary}: {url}"

#, python-brace-format
msgid "HTTP {status_code} {reason}: {url}"
msgstr "HTTP {status_code} {reason}: {url}"

#, python-brace-format
msgid "HTTP {status_code}: {url}"
msgstr "HTTP {status_code}: {url}"

#, python-brace-format
msgid "could not resolve host: {url}"
msgstr "ホスト名を解決できません: {url}"

#, python-brace-format
msgid "connection refused: {url}"
msgstr "接続を拒否されました: {url}"

#, python-brace-format
msgid "timed out after {timeout_s:g}s: {url}"
msgstr "{timeout_s:g} 秒でタイムアウトしました: {url}"

#, python-brace-format
msgid "proxy connection failed ({proxy}): {url}"
msgstr "プロキシに接続できません({proxy}): {url}"

msgid ""
"browser is not installed. Run 'playwright install chromium' (or "
"'crawl4ai-setup') and retry."
msgstr ""
"ブラウザがインストールされていません。'playwright install chromium'(または 'crawl4ai-"
"setup')を実行してから再試行してください。"

#, python-brace-format
msgid "content is not a web page and could not be downloaded: {url}"
msgstr "Web ページではなく、ダウンロードもできませんでした: {url}"

#, python-brace-format
msgid "proxy failed ({error}); retried with a direct connection"
msgstr "プロキシ経由で失敗しました({error})。直接接続で再試行しました"

#, python-brace-format
msgid "content filter failed ({reason}); saved the full page"
msgstr "コンテンツフィルタが失敗しました({reason})。ページ全体を保存しました"

msgid "content filter kept nothing; saved the full page"
msgstr "コンテンツフィルタで何も残りませんでした。ページ全体を保存しました"

#, python-brace-format
msgid "could not convert PDF to Markdown ({error}); saved the original file"
msgstr "PDF を Markdown に変換できませんでした({error})。元のファイルを保存しました"

msgid "no extractable text in PDF; saved an empty document"
msgstr "PDF から抽出できるテキストがありません。空の文書を保存しました"

#, python-brace-format
msgid "PDF saved as-is (format '{format}' does not apply)"
msgstr "PDF をそのまま保存しました(形式 '{format}' は適用できません)"

#, python-brace-format
msgid "not a web page ({media_type}); saved the original file"
msgstr "Web ページではありません({media_type})。元のファイルを保存しました"

msgid "not a web page (unknown type); saved the original file"
msgstr "Web ページではありません(形式不明)。元のファイルを保存しました"

#, python-brace-format
msgid "not an http(s) URL: {url}"
msgstr "http(s) の URL ではありません: {url}"

#, python-brace-format
msgid "unsupported proxy scheme: {proxy}"
msgstr "対応していないプロキシのスキームです: {proxy}"

#, python-brace-format
msgid "proxy URL is missing a host: {proxy}"
msgstr "プロキシ URL にホストがありません: {proxy}"

#, python-brace-format
msgid "proxy URL has an invalid port: {proxy}"
msgstr "プロキシ URL のポートが不正です: {proxy}"

#, python-brace-format
msgid "proxy URL is missing a port: {proxy}"
msgstr "プロキシ URL にポートがありません: {proxy}"

